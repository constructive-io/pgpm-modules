# pgpm-function-resolution extension
comment = 'pgpm-function-resolution extension'
default_version = '0.47.9'
module_pathname = '$libdir/pgpm-function-resolution'
requires = 'plpgsql,errors,pgpm-verify,metaschema-schema,metaschema-modules,inflection-db,pgpm-app-scope,pgpm-database-jobs,pgpm-jwt-claims'
relocatable = false
superuser = false
